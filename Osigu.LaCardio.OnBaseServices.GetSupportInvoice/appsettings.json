{
  "Logging": {
    "LogLevel": {
      "Default": "Error",
      "Microsoft": "Warning"
    },
    "Debug": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft.Hosting": "Trace"
      }
    }

  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "restrictedToMinimumLevel": "Information",
                "path": "C:\\Servinte\\Logs\\SCSE.RCM.Integration.ServiceWorkers.Rebilling\\RebillingLog.txt",
                "rollingInterval": "Day",
                "outputTemplate": "{Timestamp:HH:mm:ss} [{Level}] {MachineName} ({ThreadId}) {Message}{NewLine}{Exception}"
              }
            }
          ]
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithExceptionDetails" ]
  },
  "ApplicationContext": {
    "ClientCode": "CLIENT",
    "Provider": "Oracle",
    "ConnectionString": "Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=192.168.61.130)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=PRDDAT)));Password=produccion19;User Id=SERVINTE;",
    "ServicesURL": {
      "RcmCloudWebService": {
        "ServiceURI": "",
        "ResourcesURIs": {
          "ReassignCharges": "/rcm/v1/invoices/reassign-support-files/",
          "DupplicateSupport": "/rcm/v1/charges/duplicate-support-files/",
          "Auth": "/v1/oauth/token"
        }
      }
