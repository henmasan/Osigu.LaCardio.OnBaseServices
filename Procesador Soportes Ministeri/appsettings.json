    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "restrictedToMinimumLevel": "Information",
                "path": "C:\\Servinte\\Logs\\Importar Soportes Radicacion\\ImportarSoportes.txt",
                "rollingInterval": "Day",
                "outputTemplate": "{Timestamp:HH:mm:ss} [{Level}] {MachineName} ({ThreadId}) {Message}{NewLine}{Exception}"
              }
            }
          ]
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithExceptionDetails" ]
  },
  "Configuration": {
    "ConnectionString": "Server=172.100.1.16;Database=FCIOnBASE;User Id=hsi;Password=wstinol;",
